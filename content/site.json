    {
      "id": "telugu-affinity",
      "title": "Telugu in Affinity",
      "year": 2026,
      "cats": [
        "Type",
        "Tools"
      ],
      "one": "Makes Telugu text shape correctly in Affinity apps, and stay editable.",
      "role": "Research and build",
      "tools": "Python, OpenType",
      "links": [
        {
          "label": "GitHub",
          "url": "https://github.com/saikiran9185/telugu-affinity"
        }
      ],
      "tiles": [
        {
          "type": "text",
          "text": "స్త్రీ శ్రీ క్ష",
          "fonts": [
            "Ramaraja",
            "Noto Sans Telugu",
            "Suravaram"
          ],
          "w": 1,
          "h": 1,
          "bg": "#E6EAF0",
          "fg": "#1A1D24",
          "caption": "Conjuncts"
        }
      ],
      "blocks": [
        {
          "type": "text",
          "title": "The problem",
          "body": "Affinity Designer, Photo and Publisher have no Indic shaping, so Telugu conjuncts and vowel signs come out broken. Illustrator gets them right."
        },
        {
          "type": "text",
          "title": "The fix",
          "body": "A script rewrites a Telugu font's OpenType rules so Affinity's generic shaper gives the same result as a proper Indic shaper. Nothing is outlined, so the text stays editable."
        },
        {
          "type": "stats",
          "items": [
            {
              "n": 20142,
              "label": "letter clusters checked for Ramabhadra, all correct"
            },
            {
              "n": 8,
