      ],
      "tiles": [
        {
          "type": "image",
          "src": "media/dielineforge/carton.png",
          "w": 1074,
          "h": 1100,
          "bg": "#FFFFFF",
          "caption": "Carton dieline"
        },
        {
          "type": "image",
